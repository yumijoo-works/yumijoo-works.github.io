---
import Base from '../layouts/Base.astro';
import { site, href } from '../lib/site';

// Edit this page directly to update the CV. Each `rows` item is [when, what, sub?].
// `sub` is one line, or a list of lines shown one under another.
type Row = [string, string, (string | string[])?];

const education: Row[] = [
  ['Feb 2026', 'KAIST: M.S., Digital Humanities and Computational Social Sciences, Data Science minor', [
    'Track: Computational Social Sciences',
    'Advisor: Prof. Lanu Kim',
    'Thesis: The Power of Entry Pathways: A Study of Professional Comparison Discourse in a Korean Online Community',
  ]],
  ['Feb 2023', 'Korea National University of Arts: B.F.A., Art Theory, Cinema Studies minor'],
  ['2019', 'Beaux-Arts de Paris: exchange programme'],
];

const awards: Row[] = [
  ['2025', 'Outstanding Poster Presentation Award, 14th Korea Internet Governance Forum'],
  ['2024', 'Third Place (Team Korea), Singapore AI Safety Red Teaming Challenge, IMDA', 'Selected to represent South Korea.'],
  ['2024', 'KAIST Museum media-art open call, selected'],
  ['2024', 'Art in Culture emerging critic support programme, pitch selected'],
  ['2023', '3rd Bupyeong Emerging Curator open call, selected'],
  ['2022', 'Seoripul Youth Art Gallery exhibition open call (Seocho Foundation for Arts and Culture), selected'],
  ['2022', 'Bokdo Gallery exhibition open call, selected'],
  ['2021', 'First prize, photography and review, GKL × Gwangju Biennale'],
];

const presentations: Row[] = [
  ['2025', 'Yu, M., & Choi, J. “An Analysis of the Ambivalence within ‘Equalism’ Discourse.” Poster, 14th Korea Internet Governance Forum, Seoul. In Korean.'],
  ['2025', 'Yu, M. “For Invisible Data.” Invited talk, seminar of the Daejeon Science Art Biennale, Daejeon Museum of Art, Daejeon. In Korean.'],
];

const skills: Row[] = [
  ['Methods', 'Machine learning; natural language processing; social network analysis; LLMs and RAG; computational text analysis (topic modeling, text embeddings); Bayesian modeling; qualitative interviewing'],
  ['Programming', 'Python, R, SQL'],
  ['Software', 'Photoshop, Lightroom, InDesign'],
  ['Languages', 'Korean (native), English (advanced, IELTS 7.5), Japanese (advanced), French (intermediate, DELF B1)'],
];

const groups: [string, Row[]][] = [
  ['Education', education],
  ['Awards and selections', awards],
  ['Presentations', presentations],
  ['Skills', skills],
];
---

<Base title="About" description={`About ${site.name}: biography and CV.`}>
  <header class="page-head">
    <h1>About</h1>
    <p class="intro">
      <a href={`mailto:${site.email}`}>{site.email}</a><br />
      {site.city}
    </p>
  </header>

  <div class="cv">
    <div class="bio">
      <p>
        Yu Mijoo is a computational social scientist, curator and critic based in Seoul. His research and
        artistic practices use text analysis, network analysis and language-model pipelines to study online conflict,
        occupational discourse and the social effects of generative AI. He holds an M.S. in Digital Humanities and
        Computational Social Sciences from KAIST and a B.F.A. in Art Theory from the Korea National University of
        Arts.
      </p>
    </div>

    {groups.map(([heading, rows]) => (
      <section>
        <h2>{heading}</h2>
        <div>
          {rows.map(([when, what, sub]) => (
            <div class="row">
              <div class="when">{when}</div>
              <div class="what">
                <div>{what}</div>
                {sub && (Array.isArray(sub) ? sub : [sub]).map((line) => <div class="sub">{line}</div>)}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
