---
import Base from '../layouts/Base.astro';
import { getAllWork, sectionByKey, sections, href, year } from '../lib/site';

const all = await getAllWork();
const years = all.map((w) => w.entry.data.date.getFullYear());
const span = `${Math.min(...years)}–${Math.max(...years)}`;
---

<Base>
  <header class="page-head">
    <h1>Index</h1>
    <p class="intro">{all.length} entries, {span}. Choose a practice to see its list, newest first.</p>
  </header>

  <div class="filters" role="group" aria-label="Filter by practice">
    {sections.map((s) => (
      <button type="button" data-filter={s.key} aria-pressed="false">{s.label}</button>
    ))}
  </div>

  <noscript><style>.ledger[hidden] { display: table; }</style></noscript>

  <table class="ledger" hidden>
    <thead>
      <tr>
        <th class="y">Year</th>
        <th class="t">Title</th>
        <th class="s">Practice</th>
        <th class="k">Type</th>
        <th class="v">Venue</th>
      </tr>
    </thead>
    <tbody>
      {all.map(({ section, entry }, i) => {
        const d = entry.data;
        const y = year(d.date);
        const prev = i > 0 ? year(all[i - 1].entry.data.date) : null;
        return (
          <tr data-section={section}>
            <td class="y">{y !== prev ? y : ''}</td>
            <td class="t">
              <a href={href(`/${section}/${entry.id}/`)}>{d.title}</a>
            </td>
            <td class="s">{sectionByKey[section].label}</td>
            <td class="k">{d.type}</td>
            <td class="v">{d.venue}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</Base>

<script>
  // The list stays hidden until a practice is chosen. Clicking the chosen practice again hides it.
  // The choice is kept in the address (#research etc.) so it can be linked. Without JS the full list shows.
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const table = document.querySelector<HTMLTableElement>('.ledger')!;
  const rows = document.querySelectorAll<HTMLTableRowElement>('.ledger tbody tr');
  const yearCells = Array.from(rows).map((r) => r.querySelector('.y') as HTMLTableCellElement);
  const years = yearCells.map((c, i) => c.textContent || yearCells[i - 1]?.dataset.y || '');
  yearCells.forEach((c, i) => {
    if (!c.textContent) years[i] = years[i - 1];
    c.dataset.y = years[i];
  });

  function apply(filter: string) {
    table.hidden = !filter;
    let lastYear = '';
    rows.forEach((row, i) => {
      const show = row.dataset.section === filter;
      row.hidden = !show;
      if (show) {
        const y = years[i];
        yearCells[i].textContent = y !== lastYear ? y : '';
        lastYear = y;
      }
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
  }

  const keys = Array.from(buttons).map((b) => b.dataset.filter || '');
  let current = '';

  function choose(filter: string) {
    current = filter;
    apply(filter);
    history.replaceState(null, '', filter ? `#${filter}` : location.pathname);
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => choose(b.dataset.filter === current ? '' : b.dataset.filter || '')),
  );

  const fromHash = location.hash.slice(1);
  apply(keys.includes(fromHash) ? (current = fromHash) : '');
</script>
